    <single>false</single>
    <answer fraction="50"><text>Lipides</text><feedback format="html"><text>Ils forment la bicouche.</text></feedback></answer>
    <answer fraction="50"><text>Protéines</text><feedback><text>Elles remplissent diverses fonctions.</text></feedback></answer>
    <answer fraction="-50"><text>Chromosomes</text></answer>
    <answer fraction="-50"><text>Ribosomes</text></answer>
  </question>
